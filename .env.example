# Copy this file to .env and fill in values locally.
# Do not commit .env. Leave unused keys blank.
# This example file contains no secret values.

# Server
PORT=3000

# Optional. If set to 1, API endpoints do not send a real text or email.
# Texts stay in demo whenever this is on. Email can still go live if EMAIL_LIVE=1
# and RESEND_API_KEY plus JASON_EMAIL are also set.
DEMO_ONLY=

# Optional. If set to 1, email features send for real when RESEND_API_KEY and
# JASON_EMAIL are set, even if DEMO_ONLY=1. Does not enable texts.
EMAIL_LIVE=

# Parent-edit PIN for the wish list. If unset, the prototype default is 2468.
ADMIN_PIN=

# Twilio — used by POST /api/request-text (preset money requests)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
JASON_CELL=

# Email — used by POST /api/request-email (typed requests)
# Set JASON_EMAIL plus one provider: Resend, SendGrid, or SMTP.
JASON_EMAIL=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Customize and 24-hour change suggestions go to SUGGESTIONS_INBOX if set,
# otherwise PIPER_EMAIL. Default if both unset: piper@evaandgabe.com
PIPER_EMAIL=piper@evaandgabe.com
SUGGESTIONS_INBOX=

# Shared calendar request inbox (placeholder). Default if unset: calendar@evaandgabe.com
CALENDAR_INBOX=calendar@evaandgabe.com

# Private kid-login tokens. If unset, documented demo defaults are used (see README).
# Do not commit real tokens. The site never logs these values.
EVA_TOKEN=
GABE_TOKEN=

# Token for POST /api/inbound-email (Dad Updates feed). If unset, a documented demo default is used.
INBOUND_EMAIL_TOKEN=
